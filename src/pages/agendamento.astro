---
import MainLayout from "../layouts/MainLayout.astro"
import Booking from "../components/Booking.astro"
---

<MainLayout>
  <section class="hero">
    <div class="wrap" style="text-align: center; max-width: 760px;">
      <span class="badge">Agendamento</span>
      <h1 style="font-size: clamp(40px, 6vw, 64px);">Reserve seu horário</h1>
      <p style="color: var(--muted); font-size: 19px; margin-bottom: 0;">
        Escolha o melhor canal para agendar sua visita ao Atelier Belle. Respondemos rápido para garantir o seu momento de beleza.
      </p>
    </div>
  </section>
  <Booking />
</MainLayout>
