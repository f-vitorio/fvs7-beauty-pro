---
import Header from "../components/Header.astro"
import { salon } from "../config/salon"
import "../styles/global.css"

const { name, description, whatsappNumber } = salon
const wa = whatsappNumber || "5511999999999"
---

<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{name}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800;900&display=swap" rel="stylesheet" />

    <!-- Open Graph -->
    <meta property="og:title" content={name} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://fvs7-beauty-pro.vercel.app" />
    <meta property="og:image" content="https://fvs7-beauty-pro.vercel.app/og-image.jpg" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={name} />
    <meta name="twitter:description" content={description} />

    <!-- Canonical -->
    <link rel="canonical" href="https://fvs7-beauty-pro.vercel.app" />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>

    <!-- Footer CTA -->
    <section>
      <div class="wrap">
        <div class="footer-cta">
          <h2>Pronta para o seu próximo visual?</h2>
          <p>Reserve seu horário no Atelier Belle pelo WhatsApp. Respondemos rápido para garantir o seu momento de beleza.</p>
          <a class="cta light" href={`https://wa.me/${wa}?text=Olá! Gostaria de agendar um horário no Atelier Belle.`} target="_blank" rel="noopener">Falar no WhatsApp</a>
        </div>
      </div>
    </section>

    <footer>
      <div class="wrap">
        <span>© 2026 {name} — Todos os direitos reservados</span>
        <span>Beleza • Cuidado • Sofisticação</span>
      </div>
    </footer>
  </body>
</html>
