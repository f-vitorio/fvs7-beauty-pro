---
import Header from "../components/Header.astro"
import { salon } from "../config/salon"
import "../styles/global.css"

const { name, description, whatsappNumber, instagram, address, hours, services, professionals } = salon
---

<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{name}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:title" content={name} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://fvs7-beauty-pro.vercel.app" />
    <meta property="og:image" content="https://fvs7-beauty-pro.vercel.app/og-image.jpg" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={name} />
    <meta name="twitter:description" content={description} />

    <!-- Canonical -->
    <link rel="canonical" href="https://fvs7-beauty-pro.vercel.app" />
  </head>
  <body class="min-h-screen flex flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <footer class="border-t border-gray-100 py-8 mt-auto bg-white">
      <div class="max-w-7xl mx-auto px-6">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
          <div>
            <h4 class="font-medium mb-4">{name}</h4>
            <p class="text-gray-500 text-sm">{description}</p>
          </div>
          <div>
            <h5 class="font-medium mb-4">Serviços</h5>
            <ul class="text-sm text-gray-500">
              {services.map((service) => (
                <li>{service.name}</li>
              ))}
            </ul>
          </div>
          <div>
            <h5 class="font-medium mb-4">Profissionais</h5>
            <ul class="text-sm text-gray-500">
              {professionals.map((prof) => (
                <li>{prof.name}</li>
              ))}
            </ul>
          </div>
          <div>
            <h5 class="font-medium mb-4">Contato</h5>
            <ul class="text-sm text-gray-500">
              <li><a href={`tel:${whatsappNumber || "5511999999999"}`} class="hover:text-[#1A1A1A] transition-colors">{whatsappNumber || "55 11 99999-9999"}</a></li>
              <li><a href={`https://instagram.com/${instagram || "atelierbelle"}`} class="hover:text-[#1A1A1A] transition-colors" target="_blank" rel="noopener">Instagram</a></li>
              <li>{address}</li>
              <li>{hours}</li>
            </ul>
          </div>
        </div>
        <div class="mt-8 pt-8 border-t border-gray-100 text-center text-sm text-gray-500">
          <p>2024 Atelier Belle — Todos os direitos reservados</p>
        </div>
      </div>
    </footer>
  </body>
</html>
