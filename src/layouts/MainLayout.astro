---
import Header from "../components/Header.astro"
import { salon } from "../config/salon"

const { name } = salon
---

<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{name} — Atelier Belle</title>
    <Link rel="icon" type="image/svg+xml" href="/favicon.ico" />
    <meta name="description" content="{salon.description}" />
    
    <!-- Open Graph -->
    <meta property="og:title" content="{name} — Atelier Belle" />
    <meta property="og:description" content="{salon.description}" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://fvs7-beauty-pro.vercel.app" />
    <meta property="og:image" content="https://fvs7-beauty-pro.vercel.app/og-image.jpg" />
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content="{name} — Atelier Belle" />
    <meta property="twitter:description" content="{salon.description}" />
    
    <!-- Canonical -->
    <link rel="canonical" href="https://fvs7-beauty-pro.vercel.app" />
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Astro Output -->
    <slot />
  </head>
  <body>
    <Header />
    <main class="max-w-7xl mx-auto px-6 py-12">
      <slot />
    </main>
    <footer class="border-t border-gray-100 py-8 mt-auto">
      <div class="max-w-7xl mx-auto px-6">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
          <div>
            <h4 class="font-medium mb-4">{name}</h4>
            <p class="text-gray-500 text-sm">{salon.description}</p>
          </div>
          <div>
            <h5 class="font-medium mb-4">Serviços</h5>
            <ul class="text-sm text-gray-500">
              {salon.services.map((service) => (
                <li key={service.id}>{service.name}</li>
              ))}
            </ul>
          </div>
          <div>
            <h5 class="font-medium mb-4">Profissionais</h5>
            <ul class="text-sm text-gray-500">
              {salon.professionals.map((prof) => (
                <li key={prof.id}>{prof.name}</li>
              ))}
            </ul>
          </div>
          <div>
            <h5 class="font-medium mb-4">Contato</h5>
            <ul class="text-sm text-gray-500">
              <li><a href={`tel:${whatsappNumber || '5511999999999'}`} class="hover:text-primaryColor transition-colors">{whatsappNumber || '55 11 99999-9999'}</a></li>
              <li><a href={`https://instagram.com/${instagram || 'atelierbelle'}`} class="hover:text-primaryColor transition-colors" target="_blank" rel="noopener">Instagram</a></li>
              <li>{address}</li>
              <li>{hours}</li>
            </ul>
          </div>
        </div>
        <div class="mt-8 pt-8 border-t border-gray-100 text-center text-sm text-gray-500">
          <p>2024 Atelier Belle — Todos os direitos reservados</p>
        </div>
      </div>
    </footer>
  </body>
</html>