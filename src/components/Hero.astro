---

<!-- Hero Section - First Impactful Dobra -->
<div class="relative min-h-[600px] bg-[url('/hero/placeholder.svg')] bg-cover bg-center bg-no-repeat overflow-hidden">
  <!-- Background overlay -->
  <div class="absolute inset-0 bg-black/30"></div>
  
  <div class="relative min-h-full flex items-center px-6 py-20">
    <div class="max-w-3xl mx-auto text-center">
      <div class="inline-block px-4 py-2 mb-6 rounded-full bg-white/10 text-white text-sm font-medium">
        Beleza e sofisticação
      </div>
      <h1 class="text-5xl md:text-6xl font-bold text-white tracking-tight mb-6">
        Atelier Belle
      </h1>
      <p class="text-white text-lg md:text-xl max-w-2xl mx-auto mb-8 leading-relaxed">
        Beleza, cuidado e sofisticação em cada detalhe. Um espaço exclusivo para quem valoriza a qualidade em cada fio, cada coloração e cada detalhe do seu visual.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="#servicos" class="inline-flex items-center gap-2 px-6 py-3 bg-white text-[#1A1A1A] font-medium rounded hover:bg-gray-100 transition-colors">
          Conheça nossos serviços
        </a>
        <a href="/agendamento" class="inline-flex items-center gap-2 px-6 py-3 border border-white text-white font-medium rounded hover:bg-white/20 transition-colors">
          Agendar horário
        </a>
      </div>
    </div>
  </div>
</div>