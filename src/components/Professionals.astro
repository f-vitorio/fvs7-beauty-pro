---
import { salon } from "../config/salon"
---

<!-- Profissionais -->
<section id="profissionais" style="background: var(--soft);">
  <div class="wrap">
    <div class="section-title">
      <h2>Nossos profissionais</h2>
      <p>Cada profissional do Atelier Belle foi selecionado pela técnica impecável e pelo dom de transformar a autoestima de cada cliente.</p>
    </div>
    <div class="grid three">
      {salon.professionals.map((prof) => (
        <div class="card pro-card">
          <img src={prof.image.replace(".jpg", ".svg")} alt={prof.name} />
          <div class="pro-body">
            <h3>{prof.name}</h3>
            <p class="pro-role">{prof.specialty}</p>
            <p>{prof.description}</p>
            <div class="tags">
              {prof.services.map((s) => <span class="tag">{s}</span>)}
            </div>
            <a class="cta" href="/agendamento">Agendar consulta</a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
