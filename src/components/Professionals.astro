---
import { salon } from "../config/salon"
---

<!-- Profissionais em grid -->
<div class="grid md:grid-cols-3 gap-6">
  
  <!-- Profissional 1 -->
  <div class="border rounded-lg overflow-hidden hover:shadow-lg transition-shadow" style="border-color: var(--secondary-color, #D4AF37);">
    <div class="h-64">
      <img 
        src="/professionals/mariana.jpg" 
        alt="Mariana Costa" 
        class="w-full h-full object-cover"
      />
    </div>
    <div class="p-6">
      <h3 class="text-xl font-bold text-primaryColor mb-2">Mariana Costa</h3>
      <p class="text-gray-500 text-sm mb-3">Cabelista Master</p>
      <p class="text-gray-600 text-sm line-clamp-3">10 anos de experiência em cortes e colorações técnicas.</p>
      <div class="mt-4 flex flex-wrap gap-2">
        <span class="inline-flex items-center gap-1 px-2 py-1 bg-primaryColor/10 text-primaryColor text-xs rounded">Cortes Femininos</span>
        <span class="inline-flex items-center gap-1 px-2 py-1 bg-primaryColor/10 text-primaryColor text-xs rounded">Hidratação</span>
        <span class="inline-flex items-center gap-1 px-2 py-1 bg-primaryColor/10 text-primaryColor text-xs rounded">Coloração</span>
      </div>
      <a 
        href="/agendamento" 
        class="mt-4 inline-flex items-center gap-2 px-4 py-2 bg-primaryColor/10 text-primaryColor font-medium rounded hover:bg-primaryColor/20 transition-colors"
      >
        Agendar
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor">
          <path d="M5 3h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    </div>
  </div>

  <!-- Profissional 2 -->
  <div class="border rounded-lg overflow-hidden hover:shadow-lg transition-shadow" style="border-color: var(--secondary-color, #D4AF37);">
    <div class="h-64">
      <img 
        src="/professionals/roberta.jpg" 
        alt="Roberta Silva" 
        class="w-full h-full object-cover"
      />
    </div>
    <div class="p-6">
      <h3 class="text-xl font-bold text-primaryColor mb-2">Roberta Silva</h3>
      <p class="text-gray-500 text-sm mb-3">Colorista</p>
      <p class="text-gray-600 text-sm line-clamp-3">Especialista em colorações avançadas e tratamentos capilares.</p>
      <div class="mt-4 flex flex-wrap gap-2">
        <span class="inline-flex items-center gap-1 px-2 py-1 bg-primaryColor/10 text-primaryColor text-xs rounded">Coloração</span>
        <span class="inline-flex items-center gap-1 px-2 py-1 bg-primaryColor/10 text-primaryColor text-xs rounded">Hidratação</span>
        <span class="inline-flex items-center gap-1 px-2 py-1 bg-primaryColor/10 text-primaryColor text-xs rounded">Progressiva</span>
      </div>
      <a 
        href="/agendamento" 
        class="mt-4 inline-flex items-center gap-2 px-4 py-2 bg-primaryColor/10 text-primaryColor font-medium rounded hover:bg-primaryColor/20 transition-colors"
      >
        Agendar
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor">
          <path d="M5 3h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    </div>
  </div>

  <!-- Profissional 3 -->
  <div class="border rounded-lg overflow-hidden hover:shadow-lg transition-shadow" style="border-color: var(--secondary-color, #D4AF37);">
    <div class="h-64">
      <img 
        src="/professionals/julia.jpg" 
        alt="Julia Alves" 
        class="w-full h-full object-cover"
      />
    </div>
    <div class="p-6">
      <h3 class="text-xl font-bold text-primaryColor mb-2">Julia Alves</h3>
      <p class="text-gray-500 text-sm mb-3">Manicure e Design de Sobrancelhas</p>
      <p class="text-gray-600 text-sm line-clamp-3">Cuidado com unhas e design personalizado de sobrancelhas.</p>
      <div class="mt-4 flex flex-wrap gap-2">
        <span class="inline-flex items-center gap-1 px-2 py-1 bg-primaryColor/10 text-primaryColor text-xs rounded">Manicure Simples</span>
        <span class="inline-flex items-center gap-1 px-2 py-1 bg-primaryColor/10 text-primaryColor text-xs rounded">Alongamento de Unhas</span>
        <span class="inline-flex items-center gap-1 px-2 py-1 bg-primaryColor/10 text-primaryColor text-xs rounded">Design e Depilação</span>
      </div>
      <a 
        href="/agendamento" 
        class="mt-4 inline-flex items-center gap-2 px-4 py-2 bg-primaryColor/10 text-primaryColor font-medium rounded:hover:bg-primaryColor/20 transition-colors"
      >
        Agendar
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor">
          <path d="M5 3h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    </div>
  </div>
</div>