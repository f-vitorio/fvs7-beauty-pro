---
import { salon } from "../config/salon"

const { whatsappNumber } = salon
const wa = whatsappNumber || "5511999999999"
const { active = "home" } = Astro.props
---

<header>
  <div class="wrap">
    <nav>
      <a class="brand" href="/">
        <img src="/logo.svg" alt={`${salon.name} logo`} />
        <span>{salon.name}</span>
      </a>
      <div class="links">
        <a href="/" class={active === "home" ? "active" : ""}>Início</a>
        <a href="/#servicos" class={active === "servicos" ? "active" : ""}>Serviços</a>
        <a href="/#galeria" class={active === "galeria" ? "active" : ""}>Galeria</a>
        <a href="/#profissionais" class={active === "profissionais" ? "active" : ""}>Profissionais</a>
        <a href="/#contato" class={active === "contato" ? "active" : ""}>Contato</a>
      </div>
      <a
        class="cta"
        href={`https://wa.me/${wa}?text=Olá! Gostaria de agendar um horário no Atelier Belle.`}
        target="_blank"
        rel="noopener"
      >Agendar no WhatsApp</a>
    </nav>
  </div>
</header>
