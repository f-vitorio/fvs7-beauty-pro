---
import { salon } from "../config/salon"
import { Service } from "../types"
---

<div class="space-y-12">
  <!-- Serviço 1 -->
  <div class="border rounded-lg overflow-hidden hover:shadow-lg transition-shadow" style="border-color: var(--secondary-color, #D4AF37);">
    <div class="relative h-64">
      <img 
        src="/services/hair-cut.jpg" 
        alt="Cortes Femininos" 
        class="w-full h-full object-cover"
      />
    </div>
    <div class="p-6">
      <h3 class="text-xl font-bold text-primaryColor mb-2">Cortes Femininos</h3>
      <p class="text-gray-600 text-sm mb-4">Corte clássico e moderno</p>
      <div class="flex items-center justify-between">
        <span class="text-lg font-medium">R$ 80,00</span>
        <span class="text-sm text-gray-500">45 min</span>
      </div>
      <a 
        href="/agendamento" 
        class="mt-4 inline-flex items-center gap-2 px-4 py-2 bg-primaryColor/10 text-primaryColor font-medium rounded hover:bg-primaryColor/20 transition-colors"
      >
        Agendar
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor">
          <path d="M5 3h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    </div>
  </div>

