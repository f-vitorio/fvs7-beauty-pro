---
import { salon } from "../config/salon"
---

<!-- Serviços -->
<section id="servicos">
  <div class="wrap">
    <div class="section-title">
      <h2>Nossos serviços</h2>
      <p>Transformamos sua beleza com técnica, produtos premium e atendimento personalizado. Cada serviço foi desenvolvido para realçar sua naturalidade.</p>
    </div>
    <div class="grid three">
      {salon.services.map((service, i) => (
        <div class={`price-card${i === 3 ? " featured" : ""}`}>
          <h3>{service.name}</h3>
          <div class="price">{service.price} <small>/ {service.duration}</small></div>
          <p>{service.description}</p>
          <a class="cta" href="/agendamento">Agendar</a>
        </div>
      ))}
    </div>
  </div>
</section>
