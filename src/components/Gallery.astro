    />
    <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center text-white text-sm font-medium">
      Resultado de tratamento
    </div>
  </div>

  <!-- Galeria 4 -->
