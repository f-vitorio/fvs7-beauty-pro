---
import { salon } from "../config/salon"
---

<!-- Galeria -->
<section id="galeria">
  <div class="wrap">
    <div class="section-title">
      <h2>Galeria</h2>
      <p>Cada imagem conta uma história de transformação e beleza. Confira o trabalho do Atelier Belle e se inspire para o seu próximo visual.</p>
    </div>
    <div class="grid three">
      {salon.gallery.map((item) => (
        <a class="tile" href="/agendamento">
          <img src={item.url} alt={item.caption} loading="lazy" />
          <b>{item.caption}</b>
        </a>
      ))}
    </div>
  </div>
</section>
