---
import { salon } from "../config/salon"
---

<div class="grid grid-cols-2 md:grid-cols-3 gap-6">
  <!-- Galeria 1 -->
  <div class="border rounded-lg overflow-hidden group:hover:shadow-lg transition-shadow" style="border-color: var(--secondary-color, #D4AF37);">
    <img 
      src="/gallery/hair1.jpg" 
      alt="Corte e finalização" 
      class="w-full h-64 object-cover transition-transform duration-300 group-hover:scale-105"
    />
    <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center text-white text-sm font-medium">
      Corte e finalização
    </div>
  </div>

  <!-- Galeria 2 -->
  <div class="border rounded-lg overflow-hidden group:hover:shadow-lg transition-shadow" style="border-color: var(--secondary-color, #D4AF37);">
    <img 
      src="/gallery/color1.jpg" 
      alt="Coloração vibrante" 
      class="w-full h-64 object-cover transition-transform duration-300 group-hover:scale-105"
    />
    <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center text-white text-sm font-medium">
      Coloração vibrante
    </div>
  </div>

  <!-- Galeria 3 -->
