---
const testimonials = [
  {
    quote: "Atendimento impecável do início ao fim. Saí do salão me sentindo outra pessoa — o corte caiu exatamente como imaginei.",
    name: "Camila R.",
    role: "Cliente desde 2023",
    initial: "C",
  },
  {
    quote: "A coloração ficou viva e saudável por semanas. A equipe explica cada etapa e usa produtos de verdade. Recomendo demais.",
    name: "Fernanda L.",
    role: "Coloração premium",
    initial: "F",
  },
  {
    quote: "Ambiente lindo, pontualidade e um acabamento de unhas que dura semanas. Virou meu salão de confiança.",
    name: "Patrícia M.",
    role: "Manicure & design",
    initial: "P",
  },
]
---

<!-- Depoimentos -->
<section>
  <div class="wrap">
    <div class="section-title">
      <h2>O que nossos clientes dizem</h2>
      <p>A confiança de quem já viveu a experiência Atelier Belle.</p>
    </div>
    <div class="grid three">
      {testimonials.map((t) => (
        <div class="card">
          <div class="stars">★★★★★</div>
          <p class="quote">“{t.quote}”</p>
          <div class="who">
            <div class="avatar">{t.initial}</div>
            <div>
              <b>{t.name}</b>
              <span>{t.role}</span>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
