---
import { salon } from "../config/salon"

const { whatsappNumber, address, hours, instagram } = salon
const wa = whatsappNumber || "5511999999999"
---

<!-- Contato / Agendamento -->
<section id="contato">
  <div class="wrap">
    <div class="section-title">
      <h2>Agende seu horário</h2>
      <p>Reserve seu momento de beleza conosco. Preencha o formulário e envie sua solicitação direto no WhatsApp.</p>
    </div>
    <div class="contact-box">
      <div class="info-panel">
        <h2>Fale conosco</h2>
        <p>Resposta em até 15 minutos no horário de atendimento. Escolha o canal que preferir.</p>
        <div class="info-list">
          <div class="info-item">
            <b>WhatsApp</b>
            <span>{whatsappNumber || "55 11 99999-9999"}</span>
          </div>
          <div class="info-item">
            <b>Endereço</b>
            <span>{address}</span>
          </div>
          <div class="info-item">
            <b>Horários</b>
            <span>{hours}</span>
          </div>
          <div class="info-item">
            <b>Instagram</b>
            <a href={`https://instagram.com/${instagram || "atelierbelle"}`} target="_blank" rel="noopener">@{instagram || "atelierbelle"}</a>
          </div>
        </div>
      </div>
      <div class="form-card">
        <h3>Envie sua solicitação</h3>
        <form id="bookingForm" class="form-grid" data-wa={wa}>
          <input type="text" name="nome" placeholder="Seu nome" required />
          <input type="tel" name="telefone" placeholder="Telefone / WhatsApp" required />
          <select name="servico" required>
            <option value="" disabled selected>Escolha o serviço</option>
            {salon.services.map((s) => (
              <option value={s.name}>{s.name} — {s.price}</option>
            ))}
          </select>
          <textarea name="mensagem" placeholder="Mensagem (opcional)"></textarea>
          <button class="cta" type="submit">Enviar pelo WhatsApp</button>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById("bookingForm")
  form?.addEventListener("submit", (e) => {
    e.preventDefault()
    const f = form as HTMLFormElement
    const data = new FormData(f)
    const wa = f.dataset.wa
    const msg = [
      "Olá! Gostaria de agendar um horário no Atelier Belle.",
      `Nome: ${data.get("nome")}`,
      `Telefone: ${data.get("telefone")}`,
      `Serviço: ${data.get("servico")}`,
      data.get("mensagem") ? `Mensagem: ${data.get("mensagem")}` : "",
    ]
      .filter(Boolean)
      .join("\n")
    window.open(`https://wa.me/${wa}?text=${encodeURIComponent(msg)}`, "_blank", "noopener")
  })
</script>
